    "lucide-react": "^0.414.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.20",
    "nodemailer": "^8.0.5",
    "postcss": "^8.4.39",
    "prisma": "^5.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.4.0",
    "tailwindcss": "^3.4.7",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.0",
    "zod": "^3.23.8"

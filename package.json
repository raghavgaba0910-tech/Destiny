{
  "name": "destiny",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:clear-activity": "tsx prisma/clear-activity.ts",
    "db:reset-accounts": "tsx prisma/reset-accounts.ts",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:languages": "tsx prisma/ensure-professional-languages.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {

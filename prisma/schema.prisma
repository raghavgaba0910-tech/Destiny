generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(PATIENT)
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())

  professional  Professional?
  appointments  Appointment[]  @relation("PatientAppointments")
  assessments   Assessment[]
  checkins      CheckIn[]
  orders        Order[]
  prescriptions Prescription[] @relation("PatientPrescriptions")
  supportTickets SupportTicket[] @relation("TicketRequester")
  reviewedApplications ProfessionalApplication[] @relation("ApplicationReviewer")
}

enum Role {
  PATIENT
  COUNSELLOR
  THERAPIST
  PSYCHIATRIST
  ADMIN
}

model Professional {
  id              String   @id @default(cuid())
  professionalCode String  @unique
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  type            ProfType
  specialties     String[]
  languages       String[]
  bio             String
  experience      Int
  rating          Float
  pricePerSession Int
  tier            Tier
  isApproved      Boolean  @default(true)

  slots        Slot[]
  appointments Appointment[] @relation("ProAppointments")
}

enum ProfType {
  COUNSELLOR
  THERAPIST
  PSYCHIATRIST
}

enum Tier {
  A
  B
  C
}

model Slot {
  id             String   @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  startTime      DateTime
  isBooked       Boolean  @default(false)

  appointment Appointment?

  @@unique([professionalId, startTime])
}

model Appointment {
  id             String            @id @default(cuid())
  patientId      String
  patient        User              @relation("PatientAppointments", fields: [patientId], references: [id])
  patientName    String
  patientAge     Int
  patientGender  PatientGender
  professionalId String
  professional   Professional      @relation("ProAppointments", fields: [professionalId], references: [id])
  slotId         String            @unique
  slot           Slot              @relation(fields: [slotId], references: [id])
  status         AppointmentStatus @default(UPCOMING)
  sharedAssessmentId String?
  sharedAssessment Assessment? @relation("SharedAssessment", fields: [sharedAssessmentId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  prescriptions Prescription[]
  supportTickets SupportTicket[]
}

enum PatientGender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

model Assessment {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  type      AssessmentType
  answers   Json
  score     Int
  severity  String
  flagged   Boolean        @default(false)
  createdAt DateTime       @default(now())
  sharedAppointments Appointment[] @relation("SharedAssessment")
  supportTickets SupportTicket[]
}

enum AssessmentType {
  DEPRESSION
  ANXIETY
  SUBSTANCE
  STRESS
}

model CheckIn {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime @default(now()) @db.Date
  medication  Boolean  @default(false)
  exercise    Boolean  @default(false)
  meditation  Boolean  @default(false)
  supplements Boolean  @default(false)

  @@unique([userId, date])
}

model Prescription {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       User        @relation("PatientPrescriptions", fields: [patientId], references: [id])
  medicines     Json
  nextSessionAt DateTime?
  followUpRequired Boolean @default(true)
  followUpNotes String? @db.Text
  createdAt     DateTime    @default(now())
}

model Medicine {
  id          String @id @default(cuid())
  name        String
  type        String
  description String
  price       Int
  category    String
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  items     Json
  total     Int
  status    OrderStatus @default(PLACED)
  recipientName String?
  phoneNumber String?
  address String? @db.Text
  postalCode String?
  paymentMode PaymentMode?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  supportTickets SupportTicket[]
}

enum OrderStatus {
  PLACED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
}

enum PaymentMode {
  CASH_ON_DELIVERY
  UPI
  CARD
}

model ProfessionalApplication {
  id              String   @id @default(cuid())
  name            String
  gender          String
  type            ProfType
  experience      Int
  email           String   @unique
  phoneNumber     String
  licenseImage    String   @db.Text
  licenseMimeType String
  status          ApplicationStatus @default(PENDING)
  reviewNotes     String?  @db.Text
  reviewedById    String?
  reviewedBy      User?    @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([status, createdAt])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model SupportTicket {
  id                  String          @id @default(cuid())
  requesterId         String
  requester           User            @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  category            SupportCategory
  subject             String
  message             String           @db.Text
  relatedAppointmentId String?
  relatedAppointment  Appointment?     @relation(fields: [relatedAppointmentId], references: [id], onDelete: SetNull)
  relatedOrderId      String?
  relatedOrder        Order?           @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  relatedAssessmentId String?
  relatedAssessment  Assessment?      @relation(fields: [relatedAssessmentId], references: [id], onDelete: SetNull)
  status              SupportStatus    @default(OPEN)
  adminResponse       String?          @db.Text
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([requesterId, createdAt])
}

enum SupportCategory {
  APPOINTMENT_SCHEDULING
  LIVE_SESSION
  BILLING_REFUND_RECEIPT
  PRIVACY_DATA_ACCOUNT
  CLIENT_EHR_PLATFORM
  PAYOUTS_CLAIMS_DUES
  SESSION_INCONVENIENCE
  CLIENT_MANAGEMENT
  CONTACT_US
  OTHER
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}
